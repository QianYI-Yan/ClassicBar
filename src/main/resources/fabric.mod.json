{
  "schemaVersion": 1,
  "id": "classicbar",
  "version": "${version}",
  "name": "Classic Bar",
  "description": "把 HUD 上的状态图标替换为条形显示。",
  "icon": "assets/classicbar/icon.png",
  "authors": [
    "Tfarecnim"
  ],
  "license": "Unlicense",
  "environment": "*",
  "entrypoints": {
    "main": [
      "tfar.classicbar.ClassicBar"
    ],
    "client": [
      "tfar.classicbar.client.ClassicBarClient"
    ],
    "modmenu": [
      "tfar.classicbar.compat.ModMenuIntegration"
    ]
  },
  "mixins": [
    "classicbar.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.3",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "cloth-config": "*",
    "modmenu": "*"
  }
}
